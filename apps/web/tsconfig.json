{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/web.tsbuildinfo",
    "declaration": false,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "references": [
    {
      "path": "../../packages/web-foundation"
    },
    {
      "path": "../../packages/web-platform"
    },
    {
      "path": "../../packages/web-editor"
    },
    {
      "path": "../../packages/web-workspaces"
    },
    {
      "path": "../../packages/web-sites"
    },
    {
      "path": "../../packages/web-settings"
    },
    {
      "path": "../../packages/web-collections"
    },
    {
      "path": "../../packages/web-views"
    },
    {
      "path": "../../packages/web-templates"
    },
    {
      "path": "../../packages/web-pets"
    }
  ]
}
