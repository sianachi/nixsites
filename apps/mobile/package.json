{
  "name": "@nix/mobile",
  "version": "0.7.0",
  "private": true,
  "description": "Capacitor shell for iOS and Android: a bundled server picker that opens a Nix server's own web app",
  "scripts": {
    "sync": "cap sync ios && node scripts/app-bound-domains.mjs",
    "open": "cap open ios",
    "sync:android": "cap sync android",
    "open:android": "cap open android",
    "test": "node --test server-url.test.mjs app-bound-domains.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/share": "8.0.3",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
