# --- Markdown stays out of version control (commit only on explicit request, via git add -f) ---
*.md
# No trailing slash: these must also match the symlinks that parallel-lane
# worktrees use to reach the (untracked) standards and docs in the main
# checkout. A trailing slash matches directories only, leaving the symlink
# itself showing as untracked in every lane.
docs
# Native documentation is the repository's reviewable source; Markdown stays local.
!/docs/
/docs/*
!/docs/nix/
/docs/nix/*
!/docs/nix/nix-architecture.nix
!/docs/nix/nix-reference.nix
!/docs/nix/nix-pets.nix
!/docs/nix/nix-live-chat-decision.nix
!/docs/nix/catalog.json
# Site content snapshots from scripts/export-site-content.sh, Markdown included.
!/docs/site/
!/docs/site/**
# The Nix Sites ADRs, kept as Markdown until they are packed into the docs archive.
!/docs/adr/
/docs/adr/*
!/docs/adr/0063-nix-sites.md
!/docs/adr/0064-git-sync-and-nixmd.md
Design language for Nix review/

# Per-checkout list of paths scripts/new-goal-worktree.sh links into a lane.
# Untracked by nature: it names what this checkout has and the repository does
# not carry.
.worktree-links

# --- OS ---
.DS_Store
Thumbs.db

# --- .NET ---
bin/
obj/
artifacts/
*.user
.vs/
TestResults/
coverage/
*.coverage

# --- Node / frontend ---
node_modules/
dist/
build/
release/
.turbo/
storybook-static/
playwright-report/
test-results/
.vite/
*.tsbuildinfo

# --- Env & secrets ---
.env
.env.*
!.env.example
*.local

# Generated by deploy/seed/zitadel-configure.sh: machine-specific IdP state
# (issuer, generated client ID, dev credentials), not source.
deploy/.zitadel/

# Development signing key for personal-access-token sessions; generated per
# machine with the openssl line in .env.example, never committed.
deploy/.dev-access-token-key.pem

# --- Tooling state ---
.idea/
*.log
.pnpm-store/

# A git worktree checked out inside the repository, which is a second copy of the
# tree rather than content: committing it would commit the checkout. `nix-lanes/`
# sits outside the repository and needs no entry; this one does.
/feature/

# Private production host configuration and keys; templates remain tracked.
/deploy/*.env
/deploy/compose.host.yml
/deploy/*.pem

# Local ASP.NET Core data-protection key ring must never be committed.
/deploy/.dev-data-protection/

# Local Go build output, not source or a release artifact.
/apps/go-workers/nix-worker
/apps/go-workers/nix-worker.exe
/.local/companion/
/.local/logs/
# The site renderer's docs fixture and its golden output are source, not documentation.
!/packages/site-render/src/__fixtures__/docs
!/packages/site-render/src/__golden__/docs
!/packages/site-render/src/__golden__/docs/changelog/tag/release/
.tsbuild/
