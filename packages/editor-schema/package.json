{
  "name": "@nix/editor-schema",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "The Nix document schema: the block and mark set every stored document is validated against, shared by the web editor and the collaboration service",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-blockquote": "^3.33.1",
    "@tiptap/extension-bold": "^3.33.1",
    "@tiptap/extension-code": "^3.33.1",
    "@tiptap/extension-code-block": "^3.33.1",
    "@tiptap/extension-details": "^3.33.1",
    "@tiptap/extension-document": "^3.33.1",
    "@tiptap/extension-hard-break": "^3.33.1",
    "@tiptap/extension-heading": "^3.33.1",
    "@tiptap/extension-highlight": "^3.33.1",
    "@tiptap/extension-horizontal-rule": "^3.33.1",
    "@tiptap/extension-image": "^3.33.1",
    "@tiptap/extension-italic": "^3.33.1",
    "@tiptap/extension-link": "^3.33.1",
    "@tiptap/extension-list": "^3.33.1",
    "@tiptap/extension-paragraph": "^3.33.1",
    "@tiptap/extension-strike": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extension-text": "^3.33.1",
    "@tiptap/extension-text-style": "^3.33.1",
    "@tiptap/extension-underline": "^3.33.1",
    "@tiptap/pm": "^3.33.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7"
  }
}
