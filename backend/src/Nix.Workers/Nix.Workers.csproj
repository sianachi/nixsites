<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The worker logic that used to live in apps/go-workers: queue primitives, web push
    cryptography, bounded HTTP helpers, renderers, parsers and provider clients. Pure by
    construction: no reference to Nix.Api, no database, no configuration binding, so every
    piece here is testable on fixtures alone and the Go-to-.NET parity suites need no host.
    The hosted services that lease jobs and call Core live in Nix.Api/Workers, which
    references this project (ADR-0015 amendment: see docs/adr).
  -->
  <PropertyGroup>
    <RootNamespace>Nix.Workers</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" />
    <PackageReference Include="PdfSharp" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="Svg.Skia" />
    <!-- Security floor for PdfSharp's transitive dependency; see Directory.Packages.props. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <!-- The Go fonts (BSD, Fonts/LICENSE): the PDF and diagram renderers carry their own glyphs, as the Go worker did. -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts/*.ttf" />
  </ItemGroup>

  <!-- The CJK fallback fonts (OFL, ../../fonts/OFL.txt), fetched by scripts/fetch-pdf-fonts.sh: too large to embed or commit. -->
  <ItemGroup>
    <None Include="../../fonts/**" LinkBase="fonts" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
